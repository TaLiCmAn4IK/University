@page
@model AddModel
@{
    ViewData["Title"] = "Добавить знаменитость";
}

<h2 class="text-center mb-4">Добавить знаменитость</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success text-center">@Model.Message</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">

        @if (!Model.ShowConfirm)
        {
            @* === ШАГ 1: Форма ввода === *@
            <form method="post" enctype="multipart/form-data" asp-page-handler="Step1">
                <div class="mb-3">
                    <label class="form-label">Полное имя</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Национальность</label>
                    <input asp-for="Nationality" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Фотография</label>
                    <input asp-for="PhotoFile" class="form-control" type="file" accept="image/*" />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-page="/Index" class="btn btn-secondary">← Отмена</a>
                    <button type="submit" class="btn btn-success">Далее →</button>
                </div>
            </form>
        }
        else
        {
            @* === ШАГ 2: Подтверждение === *@
            <div class="card">
                <div class="card-body">
                    <h5>Проверьте данные:</h5>
                    <p><b>Имя:</b> @Model.FullName</p>
                    <p><b>Национальность:</b> @Model.Nationality</p>
                    @if (!string.IsNullOrEmpty(Model.TempFileName))
                    {
                        <p><b>Фото:</b> @Model.OriginalFileName</p>
                        <img src="~/images/@Model.TempFileName" style="max-width:200px; border-radius:8px;" />
                    }

                    <form method="post" asp-page-handler="Confirm" class="mt-3">
                        <input type="hidden" asp-for="FullName" />
                        <input type="hidden" asp-for="Nationality" />
                        <input type="hidden" asp-for="OriginalFileName" />
                        <input type="hidden" asp-for="TempFileName" />
                        <div class="d-flex justify-content-between">
                            <a asp-page="/Add" class="btn btn-secondary">← Назад</a>
                            <button type="submit" class="btn btn-primary">Подтвердить ✓</button>
                        </div>
                    </form>
                </div>
            </div>
        }

    </div>
</div>
