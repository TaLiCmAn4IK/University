@model DAL_Celebrity_MSSQL.Celebrity
@{
    var country = ViewData["Country"] as string ?? Model.Nationality;
}

<h2 class="text-center text-danger mb-4">Удаление знаменитости</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-body text-center">
                @Html.CelebrityFoto(Model, width: 200, height: 200)
                <h4 class="mt-3">@Model.FullName</h4>
                <p class="text-muted">@country (@Model.Nationality)</p>

                <p class="mb-3"><b>Вы действительно хотите удалить эту запись?</b></p>

                @using (Html.BeginForm("Delete", "Celebrities", new { id = Model.Id }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-between">
                        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">← Отмена</a>
                        <button type="submit" class="btn btn-danger">Удалить ✖</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
