@*
    Частичное представление для ввода данных о знаменитости.
    Применены: Html.BeginForm (создание формы) и
                Html.DropDownList (ввод национальности).
    Сервис справочника стран внедрён через директиву @inject.
*@
@model ASPA008_1.Models.CelebrityInputModel
@inject ASPA008_1.Services.ICountryCodesService Countries

@{
    var actionName = ViewData["FormAction"] as string ?? "Add";
    var submitText = ViewData["SubmitText"] as string ?? "Далее →";

    var countryItems = Countries.GetAll()
        .Select(c => new SelectListItem
        {
            Value    = c.code,
            Text     = $"{c.countryLabel} ({c.code})",
            Selected = string.Equals(c.code, Model?.Nationality, StringComparison.OrdinalIgnoreCase)
        }).ToList();
}

@using (Html.BeginForm(actionName, "Celebrities", FormMethod.Post,
        new { enctype = "multipart/form-data", @class = "needs-validation" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ReqPhotoPath)

    <div class="mb-3">
        @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Nationality, new { @class = "form-label" })
        @Html.DropDownList("Nationality", countryItems,
            "— выберите страну —",
            new { @class = "form-select", required = "required" })
        @Html.ValidationMessageFor(m => m.Nationality, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.PhotoFile, new { @class = "form-label" })
        <input type="file" name="PhotoFile" accept="image/*" class="form-control" />
        @if (!string.IsNullOrEmpty(Model?.ReqPhotoPath))
        {
            <div class="form-text">Текущее фото: <code>@Model.ReqPhotoPath</code></div>
        }
    </div>

    <div class="d-flex justify-content-between">
        <a class="btn btn-secondary" asp-action="Index">← Отмена</a>
        <button type="submit" class="btn btn-success">@submitText</button>
    </div>
}
