<UserControl x:Class="Flux.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Language toggle -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0">
            <TextBlock Text="{loc:Loc Language}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="EN / RU" Style="{StaticResource OutlineButton}" Command="{Binding ToggleLanguageCommand}"/>
        </StackPanel>

        <Border Grid.Column="1" Width="430" Style="{StaticResource Card}" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="FLUX" Style="{StaticResource HeroText}" HorizontalAlignment="Center"/>
                <TextBlock Text="E-SPORTS ARENA"
                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,22"/>

                <TextBlock Text="{loc:Loc Nickname}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="{loc:Loc Password}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,14">
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_Changed"
                                 Padding="10,8,44,8"/>
                    <TextBox x:Name="PasswordPlain" TextChanged="PasswordPlain_Changed"
                             Padding="10,8,44,8"
                             Visibility="Collapsed"/>
                    <Button x:Name="TogglePasswordButton" Click="TogglePasswordVisibility"
                            Content="👁" FontSize="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0" Width="32" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"/>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                <Button Content="{loc:Loc Login}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" Margin="0,8,0,8" Height="42"/>

                <Button Content="{loc:Loc Register}" Style="{StaticResource OutlineButton}"
                        Command="{Binding GoToRegisterCommand}" Margin="0,4,0,6" Height="38"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
