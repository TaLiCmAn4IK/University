<UserControl x:Class="Flux.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid Background="{StaticResource BackgroundBrush}" x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Адаптивная ширина: при узком окне меню сужается до 76 (только иконки/первые буквы) -->
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo -->
                    <RowDefinition Height="Auto"/>  <!-- User block -->
                    <RowDefinition Height="*"/>     <!-- Nav buttons (expands) -->
                    <RowDefinition Height="Auto"/>  <!-- Bottom actions (pinned) -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="22,22">
                    <TextBlock Text="FLUX" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- User block -->
                <Border Grid.Row="1" Padding="14,0,14,18"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Welcome}" Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Nickname}" Style="{StaticResource H2Text}"
                                   Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="{loc:Loc Play}"         Style="{StaticResource SideNavButton}" Command="{Binding NavigateQueueCommand}"/>
                        <Button Content="{loc:Loc Profile}"      Style="{StaticResource SideNavButton}" Command="{Binding NavigateProfileCommand}"/>
                        <Button Content="{loc:Loc Friends}"      Style="{StaticResource SideNavButton}" Command="{Binding NavigateFriendsCommand}"/>
                        <Button Content="{loc:Loc Search}"       Style="{StaticResource SideNavButton}" Command="{Binding NavigateSearchCommand}"/>
                        <Button Content="{loc:Loc Leaderboard}"  Style="{StaticResource SideNavButton}" Command="{Binding NavigateLeaderboardCommand}"/>
                        <Button Content="{loc:Loc Tournaments}"  Style="{StaticResource SideNavButton}" Command="{Binding NavigateTournamentsCommand}"/>
                        <Button Content="{loc:Loc Admin}"        Style="{StaticResource SideNavButton}"
                                Command="{Binding NavigateAdminCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom actions: pinned, won't overlap -->
                <StackPanel Grid.Row="3" Margin="12,10,12,18">
                    <Button Content="EN / RU" Style="{StaticResource OutlineButton}"
                            Command="{Binding ToggleLanguageCommand}" Margin="0,0,0,10"/>
                    <Button Content="{loc:Loc Logout}" Style="{StaticResource DangerButton}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content area ===== -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

        <!-- ===== Invitation toast (overlay over content; visible на всех вкладках) ===== -->
        <Border Grid.Column="1"
                Background="#CC000000"
                Visibility="{Binding InvitationVisible, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="420" MinWidth="320" Style="{StaticResource AccentCard}" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc InvitationTitle}" Style="{StaticResource H2Text}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4">
                        <Run Text="{Binding InvitationFromNickname}" FontWeight="Bold"
                             Foreground="{StaticResource AccentBrush}"/>
                        <Run Text=" "/>
                        <Run Text="{loc:Loc InvitationMessage}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,0,18">
                        <Run Text="["/>
                        <Run Text="{Binding InvitationGameLabel}"/>
                        <Run Text="]"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{loc:Loc Accept}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AcceptInvitationCommand}"
                                MinWidth="130" Height="40" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Decline}" Style="{StaticResource OutlineButton}"
                                Command="{Binding DeclineInvitationCommand}"
                                MinWidth="130" Height="40"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
