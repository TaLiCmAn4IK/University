<UserControl x:Class="Flux.Views.PlayerSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Search}" Style="{StaticResource HeroText}" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="12,10" VerticalAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="{loc:Loc Search}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SearchCommand}" Margin="12,0,0,0" MinWidth="120" Height="42"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}"
                Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Loc NoResults}" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <DataGrid ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" CanUserSortColumns="False"
                      AutoGenerateColumns="False" SelectionMode="Single" GridLinesVisibility="None"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Nickname}" Binding="{Binding Nickname}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc EloCS2Header}" Binding="{Binding EloCS2}" Width="110"/>
                    <DataGridTextColumn Header="{loc:Loc EloChessHeader}" Binding="{Binding EloChess}" Width="110"/>
                    <DataGridTemplateColumn Header="{loc:Loc Status}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc Active}"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc Banned}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="200" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{loc:Loc ViewProfile}" Style="{StaticResource OutlineButton}"
                                        Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="14,4" MinWidth="180"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="220" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{loc:Loc AddFriend}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.AddFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="14,4" MinWidth="200"
                                        IsEnabled="{Binding CanAddFriend}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
