<UserControl x:Class="Flux.Views.ChessBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <UserControl.Resources>
        <!-- Colors for light/dark squares -->
        <SolidColorBrush x:Key="LightSquareBrush" Color="#FFE8E8E0"/>
        <SolidColorBrush x:Key="DarkSquareBrush" Color="#FF555555"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="#80FFCC00"/>
        <SolidColorBrush x:Key="LegalTargetBrush" Color="#66FFCC00"/>
        <SolidColorBrush x:Key="LastMoveBrush" Color="#40FFCC00"/>
        <SolidColorBrush x:Key="CheckBrush" Color="#AAE53E3E"/>

        <!-- Square template -->
        <DataTemplate x:Key="SquareTemplate">
            <Button Command="{Binding DataContext.SquareClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" BorderThickness="0" Padding="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <!-- base color -->
                            <Border x:Name="Bg">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource DarkSquareBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLight}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource LightSquareBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- last move overlay -->
                            <Border Visibility="{Binding IsLastMove, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource LastMoveBrush}"/>
                            <!-- in-check highlight (king) -->
                            <Border Visibility="{Binding IsInCheck, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource CheckBrush}"/>
                            <!-- selection ring -->
                            <Border Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"/>

                            <!-- piece glyph: единая форма для всех фигур,
                                 различается только цвет (белая / чёрная).
                                 Контрастная подсветка по краю делает фигуру
                                 видимой и на светлых, и на тёмных клетках. -->
                            <TextBlock Text="{Binding Glyph}" FontSize="48"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- белая фигура -->
                                        <Setter Property="Foreground" Value="#FFF5F5F5"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FF000000" ShadowDepth="0"
                                                                  BlurRadius="4" Opacity="0.95"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWhitePiece}" Value="False">
                                                <!-- чёрная фигура -->
                                                <Setter Property="Foreground" Value="#FF151515"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFFFFFFF" ShadowDepth="0"
                                                                          BlurRadius="3" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- legal target dot -->
                            <Ellipse Width="20" Height="20" Fill="{StaticResource LegalTargetBrush}"
                                     Visibility="{Binding IsLegalTarget, Converter={StaticResource BoolToVisibility}}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Фиксированная ширина: при Auto колонка «разъезжалась» с каждым ходом,
                 т.к. история ходов и кнопки измерялись без ограничения по ширине. -->
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Board area -->
        <Grid Grid.Column="0" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top player (оппонент — относительно пользователя) -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#FF2A2A2A" CornerRadius="3"
                            Padding="6,3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TopSideKey}" Foreground="{StaticResource InfoBrush}"
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Style="{StaticResource H2Text}" DockPanel.Dock="Left"
                               Text="{Binding TopName}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TopElo}" Style="{StaticResource AccentText}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 8x8 board with coordinates (a-h bottom, 1-8 left) -->
            <Viewbox Grid.Row="1" Margin="0,14,0,14" Stretch="Uniform">
                <Grid Width="700" Height="700">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rank numbers (8..1 from top to bottom, for white-perspective) -->
                    <ItemsControl Grid.Row="0" Grid.Column="0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <TextBlock Text="8" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="7" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="6" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="5" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="4" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="3" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="2" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                        <TextBlock Text="1" Height="83.75" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Padding="0,33,0,0"/>
                    </ItemsControl>

                    <!-- The board itself -->
                    <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Squares}" ItemTemplate="{StaticResource SquareTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="8" Width="670" Height="670"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- File Букваs (a..h left to right) -->
                    <UniformGrid Grid.Row="1" Grid.Column="1" Columns="8" Rows="1">
                        <TextBlock Text="a" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="b" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="c" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="d" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="e" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="f" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="g" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="h" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </UniformGrid>
                </Grid>
            </Viewbox>

            <!-- Bottom player (текущий пользователь) -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#FF2A2A2A" CornerRadius="3"
                            Padding="6,3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding BottomSideKey}" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Style="{StaticResource H2Text}" DockPanel.Dock="Left"
                               Text="{Binding BottomName}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BottomElo}" Style="{StaticResource AccentText}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Side panel: status on top, move history in middle, action buttons at bottom (separated) -->
        <Grid Grid.Column="1" Margin="0,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status card -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource H2Text}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding GameOverText}" Style="{StaticResource AccentText}"
                               FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding GameOver, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Move history card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,24">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc MoveHistory}"
                               Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MoveHistoryDisplay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="4,2" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Action buttons card - clearly separated, full-width vertical stack so RU text fits -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14">
                <StackPanel>
                    <StackPanel Visibility="{Binding GameOver, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Button Content="{loc:Loc OfferDraw}" Style="{StaticResource OutlineButton}"
                                Command="{Binding OfferDrawCommand}" Height="42"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,0"
                                Margin="0,0,0,10"/>
                        <Button Content="{loc:Loc Resign}" Style="{StaticResource DangerButton}"
                                Command="{Binding ResignCommand}" Height="42"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,0"/>
                    </StackPanel>

                    <Button Content="{loc:Loc ReturnToMenu}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReturnCommand}" Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Visibility="{Binding GameOver, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
