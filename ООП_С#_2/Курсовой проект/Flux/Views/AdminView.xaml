<UserControl x:Class="Flux.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc AdminPanel}" Style="{StaticResource HeroText}"/>
            <Button Style="{StaticResource IconRefreshButton}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Root" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" Margin="0,0,2,0"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="#FF101010"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="{loc:Loc Users}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поле фильтра -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Text="{loc:Loc Filter}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding ClearFilterCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    Margin="6,0,0,0" MinWidth="40"
                                    Visibility="{Binding UserFilter, Converter={StaticResource StringNotEmptyToVisibility}}" Click="Button_Click" Width="46"/>
                            <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" VerticalContentAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="UsersGrid"
                                  ItemsSource="{Binding UsersView}" Background="Transparent" BorderThickness="0"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" AutoGenerateColumns="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column"
                                  MouseLeftButtonUp="UsersGrid_MouseLeftButtonUp">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Nickname}" Binding="{Binding Nickname}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc EloCS2Header}" Binding="{Binding EloCS2}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Loc EloChessHeader}" Binding="{Binding EloChess}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Loc Role}" Binding="{Binding RoleLabel}" Width="100"/>
                                <DataGridTemplateColumn Header="{loc:Loc Status}" Width="120"
                                                        SortMemberPath="IsBanned">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{loc:Loc Active}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                                <Setter Property="Text" Value="{loc:Loc Banned}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="10,4">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                        <Setter Property="Content" Value="{loc:Loc Ban}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                                <Setter Property="Content" Value="{loc:Loc Unban}"/>
                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc AllMatches}">
                <Border Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Matches}" Background="Transparent" BorderThickness="0"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" AutoGenerateColumns="False"
                              SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Date}" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
                            <DataGridTextColumn Header="{loc:Loc Game}" Binding="{Binding GameLabel}" Width="100"/>
                            <DataGridTextColumn Header="" Binding="{Binding Summary}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Loc Details}" Style="{StaticResource OutlineButton}"
                                                Command="{Binding DataContext.OpenMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="10,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
