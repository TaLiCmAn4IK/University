<UserControl x:Class="Flux.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{loc:Loc Friends}" Style="{StaticResource HeroText}"/>
            <Button Style="{StaticResource IconRefreshButton}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Incoming requests -->
        <Border Grid.Row="1" Style="{StaticResource AccentCard}" Padding="18" Margin="0,0,0,16"
                Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc IncomingRequests}" Style="{StaticResource H2Text}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush2}" CornerRadius="4" Padding="14,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="{loc:Loc Accept}" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" MinWidth="120" Height="36" Padding="14,0" Margin="0,0,10,0"/>
                                        <Button Content="{loc:Loc Decline}" Style="{StaticResource OutlineButton}"
                                                Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" MinWidth="120" Height="36" Padding="14,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FromNickname}" FontWeight="Bold" VerticalAlignment="Center"
                                               DockPanel.Dock="Left" FontSize="15"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Friends list -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc MyFriends}" Style="{StaticResource H2Text}" Margin="0,0,0,10"/>
                <TextBlock Text="{loc:Loc NoFriendsYet}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Visibility="{Binding HasFriends, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FriendsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush2}" CornerRadius="4" Padding="14" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{loc:Loc OpenProfile}"
                                                    Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding UserId}"
                                                    Style="{StaticResource OutlineButton}"
                                                    Height="34" MinWidth="140" Padding="12,0" Margin="0,0,8,0"/>
                                            <Button Content="{loc:Loc RemoveFriend}"
                                                    Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource OutlineButton}"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    BorderBrush="{StaticResource DangerBrush}"
                                                    Height="34" MinWidth="120" Padding="12,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nickname}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                                <Run Text="{loc:Loc CS2}"/><Run Text=":"/> <Run Text="{Binding EloCS2}"/>
                                                <Run Text="    "/><Run Text="{loc:Loc Chess}"/><Run Text=":"/> <Run Text="{Binding EloChess}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
