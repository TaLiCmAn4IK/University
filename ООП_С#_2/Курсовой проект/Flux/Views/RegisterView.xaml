<UserControl x:Class="Flux.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Language switcher (top right) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0">
            <TextBlock Text="{loc:Loc Language}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="EN / RU" Style="{StaticResource OutlineButton}" Command="{Binding ToggleLanguageCommand}"/>
        </StackPanel>

        <Border Width="460" Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{loc:Loc Register}" Style="{StaticResource H1Text}"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <TextBlock Text="{loc:Loc Nickname}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding NicknameError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding NicknameError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                <TextBlock Text="{loc:Loc Email}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding EmailError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding EmailError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                <TextBlock Text="{loc:Loc Password}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,2">
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="Pwd_Changed" Padding="10,8,44,8"/>
                    <TextBox x:Name="PasswordPlain" TextChanged="PasswordPlain_Changed"
                             Padding="10,8,44,8" Visibility="Collapsed"/>
                    <Button x:Name="TogglePasswordButton" Click="TogglePasswordVisibility"
                            Content="👁" FontSize="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0" Width="32" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"/>
                </Grid>
                <TextBlock Text="{Binding PasswordError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding PasswordError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                <TextBlock Text="{loc:Loc ConfirmPassword}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,2">
                    <PasswordBox x:Name="PasswordBoxConfirm" PasswordChanged="PwdConfirm_Changed" Padding="10,8,44,8"/>
                    <TextBox x:Name="PasswordConfirmPlain" TextChanged="PasswordConfirmPlain_Changed"
                             Padding="10,8,44,8" Visibility="Collapsed"/>
                    <Button x:Name="ToggleConfirmPasswordButton" Click="ToggleConfirmPasswordVisibility"
                            Content="👁" FontSize="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0" Width="32" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Cursor="Hand"/>
                </Grid>
                <TextBlock Text="{Binding ConfirmError}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding ConfirmError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                <TextBlock Text="{Binding GeneralError}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding GeneralError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>

                <Button Content="{loc:Loc Register}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RegisterCommand}" Height="42" Margin="0,6,0,6"/>
                <Button Content="{loc:Loc Back}" Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}" Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
