<UserControl x:Class="Flux.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid>
        <Grid Margin="36,28,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Top bar: tabs + Elo bar -->
                <RowDefinition Height="Auto"/>   <!-- Queue banner -->
                <RowDefinition Height="*"/>      <!-- Slots -->
                <RowDefinition Height="Auto"/>   <!-- Find match -->
            </Grid.RowDefinitions>

            <!-- ===== Top bar ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Game tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="CS2" Command="{Binding SelectCS2Command}" MinWidth="120" Height="44" Margin="0,0,8,0" FontSize="16">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGame}" Value="CS2">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="#FF101010"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:Loc Chess}" Command="{Binding SelectChessCommand}" MinWidth="120" Height="44" FontSize="16">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGame}" Value="Chess">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="#FF101010"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Elo bar (Faceit-style) with level badge & info icon -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10" MinWidth="460">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Level badge circle -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource SurfaceBrush2}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentLevel}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Elo value -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,14,0">
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                <Run Text="{Binding SelectedGameLabel}"/><Run Text=" Elo"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentElo}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>

                        <!-- Progress + range labels (two rows, no overlap) -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Left">
                                    <Run Text="{Binding LevelMin}"/><Run Text=" — "/><Run Text="{Binding LevelMax}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold">
                                    <Run Text="+"/><Run Text="{Binding EloToNext}"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Height="6" CornerRadius="3" Background="{StaticResource SurfaceBrush2}"/>
                        </Grid>

                        <!-- Info icon -->
                        <Button Grid.Column="3" Content="ℹ" Command="{Binding ToggleLevelTooltipCommand}"
                                Width="34" Height="34" FontSize="16" VerticalAlignment="Center"
                                Style="{StaticResource OutlineButton}" Padding="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Queue banner ===== -->
            <Border Grid.Row="1" Style="{StaticResource AccentCard}" Padding="20,12" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}">
                    <Run Text="{loc:Loc QueueRegion}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding SelectedGameLabel}"/>
                    <Run Text=" · "/>
                    <Run Text="{loc:Loc QueueLabel}"/>
                </TextBlock>
            </Border>

            <!-- ===== Slots ===== -->
            <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1200">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="200" Height="270" Margin="8">
                            <!-- Filled -->
                            <Border Style="{StaticResource Card}" Padding="0"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="♛" FontSize="22" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                                               Visibility="{Binding IsLeader, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,10,0" Width="26" Height="26" Padding="0"
                                            Command="{Binding DataContext.KickFromSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButton}"
                                            Visibility="{Binding IsLeader, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                                    <Border Grid.Row="0" Width="110" Height="110" CornerRadius="55"
                                            Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <Ellipse Width="110" Height="110">
                                                <Ellipse.Fill>
                                                    <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                                                        <ImageBrush.ImageSource>
                                                            <MultiBinding Converter="{StaticResource AvatarImage}" ConverterParameter="110">
                                                                <Binding Path="AvatarBytes"/>
                                                                <Binding Path="Nickname"/>
                                                            </MultiBinding>
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Width="28" Height="28" CornerRadius="14"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                                                    Margin="0,0,-4,-4">
                                                <TextBlock Text="{Binding Level}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="10,0,10,14" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Nickname}" FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Background="{StaticResource SurfaceBrush2}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Elo}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Empty -->
                            <Border Style="{StaticResource Card}" Padding="0"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.ToggleFriendsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Plus glyph drawn as geometry — perfectly centered, no font baseline issues -->
                                                    <Path Width="44" Height="44" Stretch="Uniform"
                                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="3"
                                                          Data="M 22,4 L 22,40 M 4,22 L 40,22"
                                                          HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc InviteFriend}" FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="120" Margin="0,12,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>

            <!-- ===== Find match ===== -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding FindMatchCommand}" MinWidth="280" Height="58" FontSize="18"
                        Content="{Binding FindMatchLabel}"/>
                <Button Content="{loc:Loc LeaveQueue}" Style="{StaticResource OutlineButton}"
                        Command="{Binding LeaveQueueCommand}" Margin="14,0,0,0" Height="58"
                        Visibility="{Binding IsInQueue, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{Binding StatusText}"
                       Style="{StaticResource AccentText}" HorizontalAlignment="Center"
                       Margin="0,96,0,0" FontSize="16"
                       Visibility="{Binding IsInQueue, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- ===== Friends flyout ===== -->
        <Border HorizontalAlignment="Right" MinWidth="280" MaxWidth="360" Width="320"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding FriendsFlyoutVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="14">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc Friends}" Style="{StaticResource H2Text}"/>
                    <Button Content="✕" DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                            Command="{Binding ToggleFriendsCommand}"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Friends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Nickname}" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                                <Run Text="{loc:Loc CS2}"/><Run Text=" Elo:"/>
                                                <Run Text="{Binding EloCS2}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Command="{Binding DataContext.InviteFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}" MinWidth="50" Height="34"
                                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                IsEnabled="{Binding IsInParty, Converter={StaticResource InverseBool}}">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="#FF101010" StrokeThickness="2.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 7,1 L 7,13 M 1,7 L 13,7"/>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Level tooltip (full table) ===== -->
        <Border Background="#CC000000"
                Visibility="{Binding LevelTooltipVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource AccentCard}" Padding="24" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{loc:Loc EloLevels}" Style="{StaticResource H2Text}"/>
                        <Button Content="✕" DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                                Command="{Binding ToggleLevelTooltipCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource MutedText}">
                            <Run Text="{loc:Loc CurrentLevel}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding CurrentLevel}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                            <Run Text=" · "/>
                            <Run Text="{loc:Loc Elo}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding CurrentElo}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}">
                            <Run Text="{loc:Loc EloToNext}"/>
                            <Run Text=": +"/>
                            <Run Text="{Binding EloToNext}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LevelRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6" Margin="0,2" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Border Width="30" Height="30" CornerRadius="15"
                                                Background="{StaticResource SurfaceBrush2}"
                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Level}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Range}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Border>

        <!-- ===== Ready-check popup (timer + Ready only) ===== -->
        <Border Background="#CC000000"
                Visibility="{Binding AcceptPopupVisible, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="440" MinWidth="320" Width="Auto" Height="330" Style="{StaticResource AccentCard}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc MatchFound}" Style="{StaticResource H1Text}" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{loc:Loc ReadyCheck}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,16"/>

                    <!-- Big countdown number -->
                    <TextBlock Text="{Binding ReadyCountdown}" FontSize="56" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{loc:Loc SecondsLeft}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Accepted: X / Y -->
                    <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,0,16">
                        <Run Text="{loc:Loc Accepted}"/><Run Text=": "/>
                        <Run Text="{Binding AcceptedCount}" Foreground="{StaticResource SuccessBrush}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalToAccept}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>

                    <Button Content="{loc:Loc Ready}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AcceptMatchCommand}" Width="200" Height="50" FontSize="18"/>
                    <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="{Binding UserAcceptedMatch, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
