<UserControl x:Class="Flux.Views.CS2MatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- ==== SERVER PICK ==== -->
        <Grid Margin="40,32,40,32"
              Visibility="{Binding Phase, ConverterParameter=ServerPick, Converter={StaticResource EnumEqualsVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding PhaseTitle}" Style="{StaticResource HeroText}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PhaseSubtitle}" Style="{StaticResource MutedText}"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding CurrentActorLabel}" Style="{StaticResource AccentText}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="{loc:Loc SelectServer}" Style="{StaticResource H2Text}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding Servers}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.PickServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource OutlineButton}" MinWidth="160" Height="60"
                                    FontSize="16" Margin="8"
                                    IsEnabled="{Binding DataContext.CanActNow, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ==== MAP BAN ==== -->
        <Grid Margin="40,32,40,32"
              Visibility="{Binding Phase, ConverterParameter=MapBan, Converter={StaticResource EnumEqualsVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,26">
                <TextBlock Text="{Binding PhaseTitle}" Style="{StaticResource HeroText}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PhaseSubtitle}" Style="{StaticResource MutedText}"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding CurrentActorLabel}" Style="{StaticResource AccentText}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource AccentText}" Margin="0,2,0,0">
                    <Run Text="{Binding MapsRemaining}"/> <Run Text=" "/> <Run Text="{loc:Loc MapsRemaining}"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,4,0,0">
                    <Run Text="{loc:Loc ServerSelected}"/> <Run Text=" "/>
                    <Run Text="{Binding SelectedServer}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Maps}" HorizontalAlignment="Center" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.BanMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="200" Height="110" Margin="10" Padding="0"
                                Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush2}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="IsEnabled"
                                            Value="{Binding DataContext.CanActNow, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc MapBanned}" FontSize="12" HorizontalAlignment="Center"
                                                           Foreground="White" Margin="0,4,0,0"
                                                           Visibility="{Binding IsBanned, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="4"
                                                    Visibility="{Binding IsBanned, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ==== Ожидание капитана (второй игрок в лобби) ==== -->
        <Grid Margin="40,32,40,32"
              Visibility="{Binding Phase, ConverterParameter=CaptainSyncWait, Converter={StaticResource EnumEqualsVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="{Binding PhaseTitle}" Style="{StaticResource HeroText}" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding PhaseSubtitle}" Style="{StaticResource MutedText}" FontSize="16"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="{Binding CurrentActorLabel}" Style="{StaticResource AccentText}" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ==== RESULT ==== -->
        <Grid Margin="32,24,32,24"
              Visibility="{Binding Phase, ConverterParameter=ResultScreen, Converter={StaticResource EnumEqualsVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AccentCard}" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ResultText}" FontSize="36" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVictory}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0">
                            <Run Text="{loc:Loc Map}"/><Run Text=": "/>
                            <Run Text="{Binding MapDisplay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text="    "/>
                            <Run Text="{loc:Loc ServerCol}"/><Run Text=": "/>
                            <Run Text="{Binding ServerDisplay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScoreTeam1}" FontSize="64" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text=":" FontSize="48" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ScoreTeam2}" FontSize="64" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Team1}" Style="{StaticResource H2Text}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Team1Rows}"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Player}" Binding="{Binding Nickname}" Width="*"/>
                                <DataGridTextColumn Header="K" Binding="{Binding Kills}" Width="40"/>
                                <DataGridTextColumn Header="D" Binding="{Binding Deaths}" Width="40"/>
                                <DataGridTextColumn Header="A" Binding="{Binding Assists}" Width="40"/>
                                <DataGridTextColumn Header="HS" Binding="{Binding Headshots}" Width="40"/>
                                <DataGridTextColumn Header="{loc:Loc ADR}" Binding="{Binding Adr, StringFormat=F1}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc HLTV}" Binding="{Binding Hltv, StringFormat=F2}" Width="60"/>
                                <DataGridTemplateColumn Header="{loc:Loc Elo}" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EloChange, Converter={StaticResource EloDeltaToText}}"
                                                       Foreground="{Binding EloChange, Converter={StaticResource EloDeltaToColor}}"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Team2}" Style="{StaticResource H2Text}" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Team2Rows}"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Player}" Binding="{Binding Nickname}" Width="*"/>
                                <DataGridTextColumn Header="K" Binding="{Binding Kills}" Width="40"/>
                                <DataGridTextColumn Header="D" Binding="{Binding Deaths}" Width="40"/>
                                <DataGridTextColumn Header="A" Binding="{Binding Assists}" Width="40"/>
                                <DataGridTextColumn Header="HS" Binding="{Binding Headshots}" Width="40"/>
                                <DataGridTextColumn Header="{loc:Loc ADR}" Binding="{Binding Adr, StringFormat=F1}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc HLTV}" Binding="{Binding Hltv, StringFormat=F2}" Width="60"/>
                                <DataGridTemplateColumn Header="{loc:Loc Elo}" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EloChange, Converter={StaticResource EloDeltaToText}}"
                                                       Foreground="{Binding EloChange, Converter={StaticResource EloDeltaToColor}}"
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Button Grid.Row="3" Content="{loc:Loc ReturnToMenu}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ReturnCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="220" Height="44"/>
        </Grid>
    </Grid>
</UserControl>
