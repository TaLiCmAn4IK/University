<UserControl x:Class="Flux.Views.TournamentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Flux.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок слева, действия справа (сначала Dock=Right для корректного DockPanel) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconRefreshButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc CreateTournament}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ShowCreateCommand}" MinWidth="180" Height="40"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc Tournaments}" Style="{StaticResource HeroText}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Форма создания -->
            <Border Grid.Row="1" Style="{StaticResource AccentCard}" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc CreateTournament}" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc TournamentName}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc Game}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{loc:Loc CS2}" Command="{Binding SelectCS2Command}"
                                Style="{StaticResource OutlineButton}"
                                MinWidth="80" Height="36" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Chess}" Command="{Binding SelectChessCommand}"
                                Style="{StaticResource OutlineButton}"
                                MinWidth="80" Height="36" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SelectedGameLabel}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc PlayerSlots}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewMaxPlayers, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc DurationMin}" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Create}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateCommand}" MinWidth="140" Height="40" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Cancel}" Style="{StaticResource OutlineButton}"
                                Command="{Binding CancelCreateCommand}" MinWidth="120" Height="40"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2Text}"/>
                                    <!-- Без Run + Binding: отдельные TextBlock -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding GameLabel}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text=" · " Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding Players}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="/" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding MaxPlayers}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text=" " Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{loc:Loc Players}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text=" · " Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" FontSize="12"
                                               Text="{Binding Countdown}"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                               Text="{Binding ParticipantList}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="🏆 " Foreground="{StaticResource AccentBrush}" FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Champion}" Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=": " Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WinnerName}" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{loc:Loc Join}"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="36" MinWidth="110" Margin="0,0,8,0"
                                            Visibility="{Binding CanJoin, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="{loc:Loc Leave}"
                                            Command="{Binding DataContext.LeaveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlineButton}"
                                            Height="36" MinWidth="110" Margin="0,0,8,0"
                                            Visibility="{Binding CanLeave, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="{loc:Loc Delete}"
                                            Command="{Binding DataContext.CancelTournamentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            Height="36" MinWidth="110"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
