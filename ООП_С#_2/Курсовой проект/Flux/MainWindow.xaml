<Window x:Class="Flux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Flux.Localization"
        xmlns:vm="clr-namespace:Flux.ViewModels"
        xmlns:v="clr-namespace:Flux.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc AppTitle}"
        Icon="pack://application:,,,/Resources/flux.ico"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BaseFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <v:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <v:MainView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <v:QueueView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CS2MatchViewModel}">
            <v:CS2MatchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChessBoardViewModel}">
            <v:ChessBoardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <v:ProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchDetailsViewModel}">
            <v:MatchDetailsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayerSearchViewModel}">
            <v:PlayerSearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <v:AdminView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FriendsViewModel}">
            <v:FriendsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaderboardViewModel}">
            <v:LeaderboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TournamentsViewModel}">
            <v:TournamentsView/>
        </DataTemplate>

        <!-- Title-bar button style: flat, square, hover-highlighted -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush2}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Custom title bar ===== -->
        <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <!-- Щит внешний (жёлтый) -->
                        <Path Fill="#FFCC00" 
                  Data="M 12 2 L 22 5 L 22 12 C 22 18 18 22 12 24 C 6 22 2 18 2 12 L 2 5 Z"/>
                        <!-- Щит внутренний (чёрный) -->
                        <Path Fill="#1A1A1A" 
                  Data="M 12 4 L 20 6.5 L 20 12 C 20 17 16.5 20.5 12 22.5 C 7.5 20.5 4 17 4 12 L 4 6.5 Z"/>
                        <!-- Жёлтая буква F -->
                        <Path Fill="#FFCC00" 
                  Data="M 9 7 L 16 8 L 16 10 L 10 10 L 10 12 L 14 12 L 14 14 L 10 14 L 10 19 L 8 19 Z"/>
                    </Canvas>
                </Viewbox>
            </StackPanel>

            <!-- Window buttons (right) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="—"
                        Click="MinimizeButton_Click" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="▢"
                        Click="MaximizeButton_Click" ToolTip="Maximize / Restore"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Content="✕"
                        Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ===== Main content ===== -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
