<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\watch_app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Ресурсы (изображения, иконка, курсор) -->
  <ItemGroup>
    <Resource Include="Images\apple.jpg" />
    <Resource Include="Images\casio.jpg" />
    <Resource Include="Images\rolex.jpg" />
    <Resource Include="Resources\watch.ico.png" />
    <Resource Include="Resources\watch_app.ico" />
    <Resource Include="Resources\watch_cursor.cur" />
  </ItemGroup>

  <!-- Файлы Strings.*.xaml включаются автоматически как Page (WPF SDK).
       Дополнительно ничего указывать не нужно. -->

</Project>
