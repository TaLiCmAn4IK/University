<UserControl x:Class="WatchShop.Controls.DiscountSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="260">

    <UserControl.Resources>
        <Style x:Key="MinimalSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Slider Grid.Column="0"
            x:Name="PART_Slider"
            Style="{StaticResource MinimalSliderStyle}"
            Minimum="0"
            Maximum="{Binding MaxDiscount, ElementName=Root}"
            Value="{Binding Discount, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Center"/>

            <!-- При сдвиге ползунка Slider обновляет своё Value.
            В XAML Value биндится двусторонне на DiscountSlider.Discount,
            поэтому DP Discount тоже обновляется. Срабатывает callback OnDiscountChanged,
            который пересчитывает фон/цвет числа справа (через DataTrigger) и поднимает три RoutedEvent. -->
            <Border Grid.Column="1" Margin="10,0,0,0"
                    Background="{DynamicResource BackgroundLightBrush}"
                    CornerRadius="4" Padding="10,4"
                    MinWidth="60">
                <TextBlock x:Name="ValueText"
                           Text="{Binding Discount, ElementName=Root, StringFormat='{}{0:F0}%'}"
                           FontWeight="SemiBold" FontSize="14"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Discount, ElementName=Root, Converter={StaticResource DiscountToFlagConverter}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- маркеры на шкале для подсказки -->
        <Grid Margin="0,2,70,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="0%" FontSize="10"
                       Foreground="{DynamicResource TextLightBrush}"
                       HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="35%" FontSize="10"
                       Foreground="{DynamicResource TextLightBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="70%" FontSize="10"
                       Foreground="{DynamicResource TextLightBrush}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</UserControl>
