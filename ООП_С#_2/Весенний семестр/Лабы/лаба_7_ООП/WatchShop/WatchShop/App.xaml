<Application x:Class="WatchShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1) Тема — должна быть первой, чтобы стили могли тянуть из неё кисти -->
                <ResourceDictionary Source="Themes/Theme.Light.xaml"/>

                <!-- 2) Локализация (по умолчанию русская) -->
                <ResourceDictionary Source="Localization/Strings.ru.xaml"/>

                <!-- 3) Стили оформления — используют DynamicResource на кисти из темы -->
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
