<Window x:Class="WatchShop.Views.EfEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ef_EditTitle}"
        Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Ef_F_Name}" Margin="0,0,0,3"/>
                <TextBox x:Name="NameBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_FullName}" Margin="0,0,0,3"/>
                <TextBox x:Name="FullNameBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_Manufacturer}" Margin="0,0,0,3"/>
                <TextBox x:Name="ManufacturerBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_Category}" Margin="0,0,0,3"/>
                <TextBox x:Name="CategoryBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_Price}" Margin="0,0,0,3"/>
                <TextBox x:Name="PriceBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_Qty}" Margin="0,0,0,3"/>
                <TextBox x:Name="QtyBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_Rating}" Margin="0,0,0,3"/>
                <TextBox x:Name="RatingBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="{DynamicResource Ef_F_Discount}" Margin="0,0,0,3"/>
                <TextBox x:Name="DiscountBox" Height="30" Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Save}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Width="120" Margin="0,0,10,0"
                    Click="Save_Click"/>
            <Button Content="{DynamicResource Cancel}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="120"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
