<Window x:Class="WatchShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoginTitle}"
        Height="340" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource LoginTitle}"
                   Style="{StaticResource PageTitleStyle}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Username}" Margin="0,0,0,2"/>
            <TextBox x:Name="UsernameTextBox" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Password}" Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordBox" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{DynamicResource LoginButton}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="100" Margin="0,0,10,0"
                    Click="LoginButton_Click" IsDefault="True"/>
            <Button Content="{DynamicResource Register}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Width="140" Margin="0,0,10,0"
                    Click="RegisterButton_Click"/>
            <Button Content="{DynamicResource CancelButton}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="100"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   x:Name="ErrorMessageTextBlock"
                   Text="{DynamicResource InvalidCredentials}"
                   Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"
                   Visibility="Collapsed" Margin="0,10,0,0"/>
    </Grid>
</Window>
