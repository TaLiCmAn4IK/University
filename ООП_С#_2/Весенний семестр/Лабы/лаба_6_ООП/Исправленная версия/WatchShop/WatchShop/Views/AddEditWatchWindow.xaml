<Window x:Class="WatchShop.Views.AddEditWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WatchShop.Controls"
        Title="{DynamicResource AddTitle}"
        Height="750" Width="900"
        MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TitleTextBlock" Grid.Row="0"
                   Text="{DynamicResource AddTitle}"
                   Style="{StaticResource PageTitleStyle}"/>

        <!-- Основная информация -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Левая колонка - подписи -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource ShortName_field}" Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Category_field}"  Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Price_field}"     Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Quantity_field}"  Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Manufacturer_field}" Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource MovementType_field}" Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Size_field}"      Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Material_field}"  Margin="5" VerticalAlignment="Center"/>

                    <!-- Левая колонка - поля -->
                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="ShortNameTextBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"/>

                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CategoryComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Cat_Luxury}"   Tag="Cat_Luxury"/>
                        <ComboBoxItem Content="{DynamicResource Cat_Sport}"    Tag="Cat_Sport"/>
                        <ComboBoxItem Content="{DynamicResource Cat_Smart}"    Tag="Cat_Smart"/>
                        <ComboBoxItem Content="{DynamicResource Cat_Classic}"  Tag="Cat_Classic"/>
                        <ComboBoxItem Content="{DynamicResource Cat_Diver}"    Tag="Cat_Diver"/>
                        <ComboBoxItem Content="{DynamicResource Cat_Aviation}" Tag="Cat_Aviation"/>
                        <ComboBoxItem Content="{DynamicResource Cat_Fashion}"  Tag="Cat_Fashion"/>
                    </ComboBox>

                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PriceTextBox"
                             Margin="5" Padding="3" Text="0" Height="35" VerticalContentAlignment="Center"/>

                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="QuantityTextBox"
                             Margin="5" Padding="3" Text="0" Height="35" VerticalContentAlignment="Center"/>

                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ManufacturerComboBox"
                              Margin="5" Padding="3" Height="35" IsEditable="True" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Rolex"/>
                        <ComboBoxItem Content="Casio"/>
                        <ComboBoxItem Content="Apple"/>
                        <ComboBoxItem Content="Seiko"/>
                        <ComboBoxItem Content="Citizen"/>
                        <ComboBoxItem Content="Omega"/>
                        <ComboBoxItem Content="Tag Heuer"/>
                    </ComboBox>

                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="MovementTypeComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Mov_Mechanical}" Tag="Mov_Mechanical"/>
                        <ComboBoxItem Content="{DynamicResource Mov_Quartz}"     Tag="Mov_Quartz"/>
                        <ComboBoxItem Content="{DynamicResource Mov_Electronic}" Tag="Mov_Electronic"/>
                        <ComboBoxItem Content="{DynamicResource Mov_Automatic}"  Tag="Mov_Automatic"/>
                        <ComboBoxItem Content="{DynamicResource Mov_Solar}"      Tag="Mov_Solar"/>
                    </ComboBox>

                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="SizeComboBox"
                              Margin="5" Padding="3" Height="35" IsEditable="True" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="38mm"/>
                        <ComboBoxItem Content="40mm"/>
                        <ComboBoxItem Content="41mm"/>
                        <ComboBoxItem Content="42mm"/>
                        <ComboBoxItem Content="44mm"/>
                        <ComboBoxItem Content="45mm"/>
                        <ComboBoxItem Content="46mm"/>
                    </ComboBox>

                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="MaterialComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Mat_Steel}"    Tag="Mat_Steel"/>
                        <ComboBoxItem Content="{DynamicResource Mat_Titanium}" Tag="Mat_Titanium"/>
                        <ComboBoxItem Content="{DynamicResource Mat_Ceramic}"  Tag="Mat_Ceramic"/>
                        <ComboBoxItem Content="{DynamicResource Mat_Plastic}"  Tag="Mat_Plastic"/>
                        <ComboBoxItem Content="{DynamicResource Mat_Carbon}"   Tag="Mat_Carbon"/>
                        <ComboBoxItem Content="{DynamicResource Mat_Gold}"     Tag="Mat_Gold"/>
                        <ComboBoxItem Content="{DynamicResource Mat_Silver}"   Tag="Mat_Silver"/>
                    </ComboBox>

                    <!-- Правая колонка - подписи -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource FullName_field}"      Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Country_field}"       Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Color_field}"         Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{DynamicResource Rating_field}"        Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{DynamicResource Discount_field}"      Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{DynamicResource WaterResistance_field}" Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="{DynamicResource Gender_field}"        Margin="5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="{DynamicResource Status_field}"        Margin="5" VerticalAlignment="Center"/>

                    <!-- Правая колонка - поля -->
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="FullNameTextBox"
                             Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"/>

                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CountryComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Cnt_Switzerland}" Tag="Cnt_Switzerland"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_Japan}"       Tag="Cnt_Japan"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_Germany}"     Tag="Cnt_Germany"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_China}"       Tag="Cnt_China"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_Russia}"      Tag="Cnt_Russia"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_USA}"         Tag="Cnt_USA"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_France}"      Tag="Cnt_France"/>
                        <ComboBoxItem Content="{DynamicResource Cnt_Italy}"       Tag="Cnt_Italy"/>
                    </ComboBox>

                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="ColorComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Clr_Black}"  Tag="Clr_Black"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Silver}" Tag="Clr_Silver"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Gold}"   Tag="Clr_Gold"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Blue}"   Tag="Clr_Blue"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Green}"  Tag="Clr_Green"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Red}"    Tag="Clr_Red"/>
                        <ComboBoxItem Content="{DynamicResource Clr_White}"  Tag="Clr_White"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Pink}"   Tag="Clr_Pink"/>
                        <ComboBoxItem Content="{DynamicResource Clr_Brown}"  Tag="Clr_Brown"/>
                    </ComboBox>

                    <ctl:StarRating Grid.Row="3" Grid.Column="3" x:Name="RatingControl"
                                    Margin="5" Height="35" VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Value="0"/>

                    <ComboBox Grid.Row="4" Grid.Column="3" x:Name="DiscountComboBox"
                              Margin="5" Padding="3" Height="35" IsEditable="True" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="0"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="40"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>

                    <ComboBox Grid.Row="5" Grid.Column="3" x:Name="WaterResistanceComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Wr_30m}"  Tag="Wr_30m"/>
                        <ComboBoxItem Content="{DynamicResource Wr_50m}"  Tag="Wr_50m"/>
                        <ComboBoxItem Content="{DynamicResource Wr_100m}" Tag="Wr_100m"/>
                        <ComboBoxItem Content="{DynamicResource Wr_200m}" Tag="Wr_200m"/>
                        <ComboBoxItem Content="{DynamicResource Wr_300m}" Tag="Wr_300m"/>
                        <ComboBoxItem Content="{DynamicResource Wr_500m}" Tag="Wr_500m"/>
                        <ComboBoxItem Content="{DynamicResource Wr_None}" Tag="Wr_None"/>
                    </ComboBox>

                    <ComboBox Grid.Row="6" Grid.Column="3" x:Name="GenderComboBox"
                              Margin="5" Padding="3" Height="35" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Gen_Men}"    Tag="Gen_Men"/>
                        <ComboBoxItem Content="{DynamicResource Gen_Women}"  Tag="Gen_Women"/>
                        <ComboBoxItem Content="{DynamicResource Gen_Unisex}" Tag="Gen_Unisex"/>
                    </ComboBox>

                    <CheckBox Grid.Column="3" Grid.Row="7" x:Name="InStockCheckBox"
                              Content="{DynamicResource InStock_field}"
                              Margin="5" VerticalAlignment="Center" IsChecked="True"/>
                </Grid>

                <!-- Описание -->
                <Border Margin="5,15,5,5" Padding="10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Description_field}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="1" x:Name="DescriptionTextBox"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="100" Padding="8" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <!-- Изображения -->
                <Border Margin="5,15,5,5" Padding="10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="5" Background="{DynamicResource BackgroundLightBrush}"
                        AllowDrop="True"
                        Drop="ImageBorder_Drop"
                        DragOver="ImageBorder_DragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Images_field}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <ListBox Grid.Row="1" x:Name="ImagesListBox"
                                 Height="120" Margin="0,0,0,10"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding}" Width="50" Height="50" Margin="5"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Content="{DynamicResource AddImage}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="170" Margin="5"
                                    Click="AddImage_Click"/>
                            <Button Content="{DynamicResource RemoveImage}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Width="100" Margin="5"
                                    Click="RemoveImage_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{DynamicResource DragDropHint}"
                                   Foreground="#666" HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{DynamicResource Save}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Width="120" Height="40" Margin="0,0,15,0"
                    FontWeight="Bold"
                    Click="SaveButton_Click"/>
            <Button Content="{DynamicResource Cancel}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="120" Height="40"
                    FontWeight="Bold"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{DynamicResource Required}"
                   Foreground="Gray" FontSize="11"
                   HorizontalAlignment="Left" Margin="0,5,0,0"/>
    </Grid>
</Window>
