<Window x:Class="WatchShop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Register_Title}"
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Register_Title}"
                   Style="{StaticResource PageTitleStyle}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Username}" Margin="0,0,0,2"/>
            <TextBox x:Name="UsernameBox"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Email:" Margin="0,0,0,2"/>
            <TextBox x:Name="EmailBox"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Password}" Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Register_PasswordConfirm}" Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordConfirmBox"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="ErrorText"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,5,0,0"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Register_Submit}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Width="130" Margin="0,0,10,0"
                    Click="RegisterButton_Click" IsDefault="True"/>
            <Button Content="{DynamicResource CancelButton}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="100"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
