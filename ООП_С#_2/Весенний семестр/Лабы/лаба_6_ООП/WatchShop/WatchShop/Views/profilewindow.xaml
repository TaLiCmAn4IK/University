<Window x:Class="WatchShop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="личный кабинет" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- заголовок -->
        <TextBlock x:Name="TitleTextBlock" Grid.Row="0" 
                   Text="личный кабинет" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"
                   Foreground="#1A1A1A"/>

        <!-- имя пользователя (только чтение) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="UsernameLabel" Text="имя пользователя:" Margin="0,0,0,2"/>
            <TextBox x:Name="UsernameTextBox" IsReadOnly="True" Background="#F5F5F5"/>
        </StackPanel>

        <!-- email -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="EmailLabel" Text="email:" Margin="0,0,0,2"/>
            <TextBox x:Name="EmailTextBox" Padding="5"/>
        </StackPanel>

        <!-- пароль (изменение) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock x:Name="PasswordLabel" Text="новый пароль:" Margin="0,0,0,2"/>
            <PasswordBox x:Name="NewPasswordBox" Padding="5"/>
            <TextBlock x:Name="PasswordHint" Text="оставьте пустым, чтобы не менять" 
                       FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- разделитель -->
        <Separator Grid.Row="4" Margin="0,10"/>

        <!-- настройки языка -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock x:Name="LanguageLabel" Text="язык интерфейса:" Margin="0,0,0,5" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RussianRadio" Content="русский" GroupName="Language" Margin="0,0,15,0"/>
                <RadioButton x:Name="EnglishRadio" Content="english" GroupName="Language"/>
            </StackPanel>
        </StackPanel>

        <!-- кнопки -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="сохранить" 
                    Width="120" Height="35" Margin="0,0,10,0"
                    Click="SaveButton_Click"
                    Background="#27ae60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="CancelButton" Content="отмена" 
                    Width="120" Height="35" 
                    Click="CancelButton_Click"
                    Background="#e74c3c" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>