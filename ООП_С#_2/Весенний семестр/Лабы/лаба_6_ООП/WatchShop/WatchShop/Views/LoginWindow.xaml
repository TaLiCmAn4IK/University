<Window x:Class="WatchShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="вход в систему" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="ToolWindow"
        ResizeMode="NoResize" 
        Background="White"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" 
                   Text="вход в систему" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"
                   Foreground="#1A1A1A"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="UsernameTextBlock" Text="имя пользователя:" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox" Padding="8" Height="35"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock x:Name="PasswordTextBlock" Text="пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Padding="8" Height="35"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="LoginButton" 
                    Content="войти" 
                    Width="100" Height="35" 
                    Margin="0,0,10,0" 
                    Click="LoginButton_Click"
                    Background="#1A1A1A" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button x:Name="CancelButton" 
                    Content="отмена" 
                    Width="100" Height="35" 
                    Click="CancelButton_Click"
                    Background="#1A1A1A" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <TextBlock x:Name="ErrorMessageTextBlock" Grid.Row="4" 
                   Text="неверное имя пользователя или пароль" 
                   Foreground="#e74c3c" 
                   HorizontalAlignment="Center"
                   Visibility="Collapsed" 
                   Margin="0,5,0,0"
                   FontWeight="Bold"/>
    </Grid>
</Window>