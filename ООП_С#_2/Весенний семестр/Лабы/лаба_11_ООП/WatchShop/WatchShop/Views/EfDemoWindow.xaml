<Window x:Class="WatchShop.Views.EfDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ef_Title}"
        Height="700" Width="1050"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Ef_Title}"
                   Style="{StaticResource PageTitleStyle}"/>

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource Ef_Subtitle}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Панель поиска / фильтра / сортировки (LINQ to Entities) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BackgroundLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Ef_Search}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="200" Margin="0,0,15,0"
                         VerticalContentAlignment="Center" Height="30"/>

                <TextBlock Text="{DynamicResource Ef_PriceFrom}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="MinPriceBox" Width="80" Margin="0,0,15,0"
                         VerticalContentAlignment="Center" Height="30"/>

                <TextBlock Text="{DynamicResource Ef_PriceTo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="MaxPriceBox" Width="80" Margin="0,0,15,0"
                         VerticalContentAlignment="Center" Height="30"/>

                <CheckBox x:Name="InStockCheck" Content="{DynamicResource Ef_InStock}"
                          VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Text="{DynamicResource Ef_SortBy}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SortBox" Width="150" Height="30" Margin="0,0,15,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource Ef_SortName}" Tag="Name"/>
                    <ComboBoxItem Content="{DynamicResource Ef_SortPriceAsc}" Tag="PriceAsc"/>
                    <ComboBoxItem Content="{DynamicResource Ef_SortPriceDesc}" Tag="PriceDesc"/>
                    <ComboBoxItem Content="{DynamicResource Ef_SortRating}" Tag="Rating"/>
                    <ComboBoxItem Content="{DynamicResource Ef_SortSold}" Tag="Sold"/>
                </ComboBox>

                <Button Content="{DynamicResource Ef_Find}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="75" Height="32"
                        Click="Search_Click"/>
            </WrapPanel>
        </Border>

        <!-- Таблица результатов (LINQ to Entities → DataGrid) -->
        <DataGrid Grid.Row="3" x:Name="WatchesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single"
                  AlternatingRowBackground="{DynamicResource BackgroundLightBrush}"
                  RowHeight="30" HeadersVisibility="Column"
                  Background="{DynamicResource BackgroundWhiteBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="{DynamicResource Hdr_Name}" Binding="{Binding ShortName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Ef_Col_Manufacturer}"
                                    Binding="{Binding Manufacturer.Name}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource Ef_Col_Category}"
                                    Binding="{Binding Category.Name}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource Ef_Col_Price}"
                                    Binding="{Binding Price, StringFormat={}{0:F2}}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource Ef_Col_Qty}"
                                    Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="{DynamicResource Ef_Col_Sold}"
                                    Binding="{Binding SoldCount}" Width="80"/>
                <DataGridCheckBoxColumn Header="{DynamicResource Ef_Col_InStock}"
                                        Binding="{Binding InStock}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- CRUD-кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{DynamicResource Ef_Add}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Width="150" Margin="0,0,8,0"
                    Click="Add_Click"/>
            <Button Content="{DynamicResource Ef_Edit}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="150" Margin="0,0,8,0"
                    Click="Edit_Click"/>
            <Button Content="{DynamicResource Ef_Delete}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="150" Margin="0,0,8,0"
                    Click="Delete_Click"/>
            <Button Content="{DynamicResource Ef_Refresh}"
                    Style="{StaticResource InfoButtonStyle}"
                    Width="150"
                    Click="Refresh_Click" Height="36"/>
        </StackPanel>

        <!-- Статус-строка + счётчик -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1"
                    Content="{DynamicResource Details_Close}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="110"
                    Click="Close_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
