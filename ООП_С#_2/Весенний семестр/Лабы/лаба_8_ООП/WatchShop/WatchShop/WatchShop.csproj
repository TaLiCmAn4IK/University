<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\watch_app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- ADO.NET для SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Доступ к App.config через ConfigurationManager -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!-- Графика, иконка, курсор -->
  <ItemGroup>
    <Resource Include="Images\apple.jpg" />
    <Resource Include="Images\casio.jpg" />
    <Resource Include="Images\rolex.jpg" />
    <Resource Include="Resources\watch.ico.png" />
    <Resource Include="Resources\watch_app.ico" />
    <Resource Include="Resources\watch_cursor.cur" />
  </ItemGroup>

  <!-- SQL-скрипт инициализации БД встраивается в exe как embedded resource -->
  <ItemGroup>
    <EmbeddedResource Include="Database\InitDatabase.sql" />
  </ItemGroup>

</Project>
