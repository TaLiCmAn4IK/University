<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====== РОЗОВАЯ ТЕМА ====== -->
    <sys:String x:Key="ThemeId">Pink</sys:String>

    <Color x:Key="PrimaryColor">#C2185B</Color>
    <Color x:Key="SecondaryColor">#AD1457</Color>
    <Color x:Key="AccentColor">#E91E63</Color>
    <Color x:Key="SuccessColor">#43A047</Color>
    <Color x:Key="DangerColor">#D32F2F</Color>
    <Color x:Key="WarningColor">#FB8C00</Color>
    <Color x:Key="InfoColor">#EC407A</Color>

    <Color x:Key="BackgroundLight">#FFF0F5</Color>
    <Color x:Key="BackgroundWhite">#FFF8FB</Color>
    <Color x:Key="BackgroundCard">#FFFFFF</Color>
    <Color x:Key="BorderColor">#F8BBD0</Color>

    <Color x:Key="TextPrimary">#3E1129</Color>
    <Color x:Key="TextSecondary">#6A2A47</Color>
    <Color x:Key="TextLight">#A85B7E</Color>
    <Color x:Key="TextWhite">#FFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>

    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{DynamicResource BackgroundLight}"/>
    <SolidColorBrush x:Key="BackgroundWhiteBrush" Color="{DynamicResource BackgroundWhite}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{DynamicResource BackgroundCard}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{DynamicResource TextLight}"/>
    <SolidColorBrush x:Key="TextWhiteBrush" Color="{DynamicResource TextWhite}"/>

    <SolidColorBrush x:Key="PriceBrush" Color="#C2185B"/>
    <SolidColorBrush x:Key="StarBrush" Color="#E91E63"/>

</ResourceDictionary>
