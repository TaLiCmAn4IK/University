<Window x:Class="WatchShop.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Admin_Title}"
        Height="640" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Admin_Title}"
                   Style="{StaticResource PageTitleStyle}"/>

        <!-- =================================================================
             Кнопки навигации между таблицами БД.
             Каждая загружает соответствующую таблицу через SqlDataAdapter
             в DataGrid через привязку данных к DataTable.DefaultView.
             ================================================================= -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="WatchesNavBtn" Content="{DynamicResource Admin_Watches}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="160" Margin="0,0,8,0"
                    Click="ShowWatches_Click"/>
            <Button x:Name="UsersNavBtn" Content="{DynamicResource Admin_Users}"
                    Style="{StaticResource InfoButtonStyle}"
                    Width="160" Margin="0,0,8,0"
                    Click="ShowUsers_Click"/>
            <Button x:Name="OrdersNavBtn" Content="{DynamicResource Admin_Orders}"
                    Style="{StaticResource InfoButtonStyle}"
                    Width="160"
                    Click="ShowOrders_Click"/>

            <Separator Style="{x:Null}" Width="20"/>

            <TextBlock x:Name="CurrentTableLabel"
                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Button Content="🔄"
                    Style="{StaticResource RoundIconButtonStyle}"
                    Margin="15,0,0,0"
                    ToolTip="Обновить"
                    Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- DataGrid отображает текущую таблицу. ItemsSource привязан к
             DataTable.DefaultView — DataGrid сам генерирует колонки. -->
        <DataGrid Grid.Row="2"
                  x:Name="MainGrid"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="{DynamicResource BackgroundLightBrush}"
                  RowHeight="32"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundWhiteBrush}"/>

        <!-- Подвал: счётчик строк + Закрыть -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="RowsCountText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="{DynamicResource Details_Close}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="120"
                    Click="CloseButton_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
