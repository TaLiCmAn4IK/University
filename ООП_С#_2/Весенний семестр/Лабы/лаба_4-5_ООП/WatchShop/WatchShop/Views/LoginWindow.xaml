<Window x:Class="WatchShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="ToolWindow"
        ResizeMode="NoResize" 
        Background="White"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" 
                   Text="Вход в систему" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"
                   Foreground="#1A1A1A"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="UsernameTextBlock" Text="Имя пользователя:" Margin="0,0,0,2"/>
            <TextBox x:Name="UsernameTextBox" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock x:Name="PasswordTextBlock" Text="Пароль:" Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordBox" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="LoginButton" 
                    Content="Войти" 
                    Width="100" Height="35" 
                    Margin="0,0,10,0" 
                    Click="LoginButton_Click"
                    Background="#1A1A1A" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button x:Name="CancelButton" 
                    Content="Отмена" 
                    Width="100" Height="35" 
                    Click="CancelButton_Click"
                    Background="#1A1A1A" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <TextBlock x:Name="ErrorMessageTextBlock" Grid.Row="4" 
                   Text="Неверное имя пользователя или пароль" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Visibility="Collapsed" Margin="0,10,0,0"/>
    </Grid>
</Window>