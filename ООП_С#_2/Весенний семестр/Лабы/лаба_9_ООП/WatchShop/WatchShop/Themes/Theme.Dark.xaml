<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====== ТЁМНАЯ ТЕМА ====== -->
    <sys:String x:Key="ThemeId">Dark</sys:String>

    <Color x:Key="PrimaryColor">#0F0F0F</Color>
    <Color x:Key="SecondaryColor">#1E1E1E</Color>
    <Color x:Key="AccentColor">#3D8BFD</Color>
    <Color x:Key="SuccessColor">#2ecc71</Color>
    <Color x:Key="DangerColor">#ff6b6b</Color>
    <Color x:Key="WarningColor">#ffc857</Color>
    <Color x:Key="InfoColor">#4dabf7</Color>

    <Color x:Key="BackgroundLight">#1A1A1A</Color>
    <Color x:Key="BackgroundWhite">#252525</Color>
    <Color x:Key="BackgroundCard">#2E2E2E</Color>
    <Color x:Key="BorderColor">#454545</Color>

    <Color x:Key="TextPrimary">#F0F0F0</Color>
    <Color x:Key="TextSecondary">#BBBBBB</Color>
    <Color x:Key="TextLight">#888888</Color>
    <Color x:Key="TextWhite">#FFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>

    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{DynamicResource BackgroundLight}"/>
    <SolidColorBrush x:Key="BackgroundWhiteBrush" Color="{DynamicResource BackgroundWhite}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{DynamicResource BackgroundCard}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{DynamicResource TextLight}"/>
    <SolidColorBrush x:Key="TextWhiteBrush" Color="{DynamicResource TextWhite}"/>

    <SolidColorBrush x:Key="PriceBrush" Color="#2ecc71"/>
    <SolidColorBrush x:Key="StarBrush" Color="#ffc857"/>

</ResourceDictionary>
