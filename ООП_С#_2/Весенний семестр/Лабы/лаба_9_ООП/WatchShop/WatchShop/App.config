<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
  Конфигурация подключения к SQL Server и параметров приложения.

  Формат сервера:
    localhost                — экземпляр по умолчанию (когда у тебя
                               стоит "DESKTOP-IMNOJB5" без слеша — это он)
    localhost\SQLEXPRESS     — именованный экземпляр SQLEXPRESS
    .\MSSQLSERVER            — полное имя
  -->
  <connectionStrings>
    <!-- Подключение к серверу без указания БД — нужно для CREATE DATABASE (лаб 8) -->
    <add name="MasterConnection"
         connectionString="Server=localhost;Database=master;Integrated Security=true;TrustServerCertificate=true;"
         providerName="Microsoft.Data.SqlClient" />

    <!-- Основное подключение приложения к БД WatchShopDB (лаб 8, ADO.NET) -->
    <add name="WatchShopConnection"
         connectionString="Server=localhost;Database=WatchShopDB;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true;"
         providerName="Microsoft.Data.SqlClient" />

    <!-- ===== Лаб 9: строка подключения для Entity Framework Core =====
         EF Core использует ту же БД WatchShopDB, но через свой провайдер.
         Параметры в App.config (как требует ТЗ лаб 9 п.2). -->
    <add name="EfConnection"
         connectionString="Server=localhost;Database=WatchShopDB;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=true;"
         providerName="Microsoft.EntityFrameworkCore.SqlServer" />
  </connectionStrings>

  <appSettings>
    <!-- Имя БД, которое будет использоваться в проверке существования -->
    <add key="DatabaseName" value="WatchShopDB" />
    <!-- Импортировать ли данные из старого JSON-хранилища при первом запуске -->
    <add key="ImportFromJsonOnFirstRun" value="true" />
  </appSettings>

</configuration>
