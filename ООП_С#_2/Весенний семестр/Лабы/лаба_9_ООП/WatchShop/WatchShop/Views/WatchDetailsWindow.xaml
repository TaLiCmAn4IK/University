<Window x:Class="WatchShop.Views.WatchDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WatchShop.Controls"
        Title="{DynamicResource Details_Title}"
        Height="640" Width="720"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="{Binding ShortName}"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalAlignment="Left"/>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: фото + цена + рейтинг -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <Border Background="{DynamicResource BackgroundLightBrush}" Height="260" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="⌚" FontSize="100"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#999"/>
                            <!-- Лаб 8: BLOB-фото из БД (поверх иконки-заглушки) -->
                            <Image Source="{Binding ImageData, Converter={StaticResource BytesToImageConverter}}"
                                   Stretch="Uniform" Margin="10"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Margin="0,15,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Details_Price}"
                                       FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Price, StringFormat='${0:F2}'}"
                                       FontSize="22" Foreground="{DynamicResource PriceBrush}"
                                       FontWeight="Bold"/>

                            <StackPanel Margin="0,10,0,0">
                                <!-- Скидка показывается всегда; если 0% — значит просто "Скидка: 0%" -->
                                <TextBlock>
                                    <Run Text="{DynamicResource Details_Discount}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding Discount, Mode=OneWay}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="{DynamicResource Details_DiscountedPrice}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding DiscountedPrice, StringFormat='${0:F2}', Mode=OneWay}"
                                         Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Margin="0,15,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Details_Stock}"
                                       FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding AvailableText}" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Правая колонка: характеристики и описание -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding FullName}" FontSize="16"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Основная информация -->
                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Details_Category}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CategoryDisplay}" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Details_Manufacturer}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Details_Country}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CountryDisplay}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Details_Rating}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <ctl:StarRating Value="{Binding Rating}" IsReadOnly="True"/>
                                <TextBlock Text="{Binding Rating, StringFormat=' ({0:F1})'}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Технические характеристики -->
                    <TextBlock Text="{DynamicResource Details_Characteristics}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,5"/>

                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Details_MovementType}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MovementTypeDisplay}" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Details_Size}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Size}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Details_Material}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MaterialDisplay}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Details_Color}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ColorDisplay}" Margin="0,3"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Details_WaterResistance}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WaterResistanceDisplay}" Margin="0,3"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Details_Gender}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GenderDisplay}" Margin="0,3"/>
                        </Grid>
                    </Border>

                    <!-- Описание -->
                    <TextBlock Text="{DynamicResource Details_Description}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,5"/>
                    <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="15">
                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопка закрыть -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Details_Close}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Height="36"
                    Click="CloseButton_Click" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
