<Window x:Class="WatchShop.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Stats_Title}"
        Height="540" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundWhiteBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Resources/watch.ico.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Stats_Title}"
                   Style="{StaticResource PageTitleStyle}"/>

        <!-- Карточка с агрегатами (sp_GetStatistics) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="{DynamicResource Stats_Watches}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="WatchCountText" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="{DynamicResource Stats_InStock}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="InStockText" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="{DynamicResource Stats_Users}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="UserCountText" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource InfoBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,15,5,5">
                    <TextBlock Text="{DynamicResource Stats_Orders}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="OrderCountText" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,15,5,5">
                    <TextBlock Text="{DynamicResource Stats_Revenue}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="RevenueText" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PriceBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="5,15,5,5">
                    <TextBlock Text="{DynamicResource Stats_Sold}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="SoldText" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{DynamicResource Stats_TopSelling}"
                   Style="{StaticResource SectionTitleStyle}"/>

        <!-- Топ-5 продаваемых, через хранимую процедуру sp_GetTopSelling -->
        <DataGrid Grid.Row="3" x:Name="TopGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="{DynamicResource BackgroundLightBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Width="60">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ID"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Name}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Hdr_Name}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding SoldCount}" Width="120">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Stats_SoldCount}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Stats_Refresh}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Margin="0,0,10,0"
                    Click="RefreshButton_Click"/>
            <Button Content="{DynamicResource Details_Close}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="120"
                    Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
