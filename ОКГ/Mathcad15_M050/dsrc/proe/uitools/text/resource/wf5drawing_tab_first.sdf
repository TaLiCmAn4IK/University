; 01-Apr-09 L-03-30  IKAL  $$2  Fixed the ContentMargins.
; 04-Aug-09 L-03-35  IKAL  $$3  Updated.


[togglebutton]
SizingMargins = 2, 2, 13, 2
ContentMargins = 7, 2, 2, 2
BackgroundImage = styles/overlap_tab/first.png
TextColor = 48 60 66

[togglebutton(hot)]
BackgroundImage = styles/overlap_tab/first_hot.png
TextColor = 48 60 66

[togglebutton(checked)]
BackgroundImage = styles/overlap_tab/first_selected.png
TextColor = 48 60 66

[togglebutton(hotchecked)] = togglebutton(checked)

[togglebutton(pressed)]
BackgroundImage = styles/overlap_tab/first_pressed.png
TextColor = 48 60 66


[toolbutton] = togglebutton
