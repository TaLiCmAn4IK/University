[layoutbody]
SizingMargins = 1, 1, 1, 1
BackgroundImage = styles/fileopen/file_open_toolbar.png

[toolbarhorz]
SizingMargins = 1, 1, 1, 1
BackgroundImage = styles/fileopen/file_open_toolbar.png

[toolbutton]
;ForegroundColor = White
ContentMargins = 3, 3, 3, 3
SizingMargins = 3, 3, 3, 3
BackgroundImage = styles/fileopen/file_open_toolbar_transparent.bif

[toolbutton(hot)]
TextColor = White
BackgroundImage = styles/fileopen/file_open_toolbar_hot.png

[toolbutton(focused)] = toolbutton(hot)
[toolbutton(hover)] = toolbutton(hot)

[toolbutton(pressed)]
BackgroundImage = styles/fileopen/file_open_toolbar_pressed.png
