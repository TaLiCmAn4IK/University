; Applet bottom half layout
;
; 13-Dec-06 L-01-22 AW    $$1   Created
; 20-May-08 L-03-09 Asaf  $$2   Updated for beige
;

[layoutbody]
ContentMargins = 4, 0, 4, 3
SizingMargins = 3, 0, 3, 3
;TextColor = 51 94 168
BackgroundImage = styles/ribbon/beige/ribbonappletbottom.bif

[toolbutton]
ContentMargins 2, 2, 2, 2
SizingMargins 1, 1, 1, 1
Size = 16, 16
BackgroundImage = styles/ribbon/beige/blank.bif

[toolbutton(hot)]
ContentMargins = 3, 2, 2, 2
SizingMargins  = 2, 2, 2, 2
SizingType = Stretch
BackgroundImage = styles/ribbon/beige/toolbuttonhot.bif

[toolbutton(pressed)]
ContentMargins  = 2, 2, 3, 2
SizingMargins  = 2, 2, 2, 2
SizingType = Stretch
BackgroundImage = styles/ribbon/beige/toolbuttonpressed.bif
