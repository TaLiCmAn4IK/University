[toolbutton]
ContentMargins = 2, 2, 2, 2
SizingMargins = 3, 2, 1, 1
TransitionDuration = 250
BackgroundImage = styles/SAB/middle_button_normal.bif

[toolbutton(hot)]
TransitionDuration = 250
BackgroundImage = styles/SAB/middle_button_hot.bif

[toolbutton(pressed)]
TransitionDuration = 250
BackgroundImage = styles/SAB/middle_button_pressed.bif

[comboboxbutton]
ContentMargins = 2, 2, 2, 2
SizingMargins = 3, 2, 1, 1
Size = 20, 20
TransitionDuration = 250
BackgroundImage = styles/SAB/SAB_transparent.bif
Glyph = UI OptionMenu image

[comboboxbutton(hot)]
TransitionDuration = 250
BackgroundImage = styles/SAB/middle_button_hot.bif

[comboboxbutton(pressed)]
TransitionDuration = 250
BackgroundImage = styles/SAB/middle_button_pressed.bif
