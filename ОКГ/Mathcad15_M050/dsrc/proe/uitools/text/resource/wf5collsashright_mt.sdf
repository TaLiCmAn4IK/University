; ToggleButton

[togglebutton]
BackgroundImage = styles/col_sash/col_sash_right_arrow_wf5modeltree.png
Size = 9, 94
ContentMargins = 1, 1, 1, 1

[togglebutton(hot)]
BackgroundImage = styles/col_sash/col_sash_right_arrow_wf5modeltree_hot.png

[togglebutton(hotchecked)] = togglebutton(hot)

[togglebutton(pressed)]
BackgroundImage = styles/col_sash/col_sash_right_arrow_wf5modeltree_pressed.png
