; Main Ribbon style definition
;
; 24-Aug-08 L-03-16 Asaf  $$1   Created (from PV, then PD)
; 11-Feb-09 L-03-26 AlexM $$2   Fixed for Cascade Button
; 22-Mar-09 L-03-29 AlexM $$3   Added toolbutton

; All toggle button states use same SizingMargins
[togglebutton]
ContentMargins = 6, 3, 6, 2
SizingMargins = 6, 3, 6, 2
BackgroundImage = styles/ribbon/beige/ribbontabbutton.png

[togglebutton(hot)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonhot.png

[togglebutton(pressed)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonhot.png

[togglebutton(checked)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonselected.png

[togglebutton(hotchecked)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonselectedhot.png

[toolbutton] = togglebutton

[splitbutton] = togglebutton

[splitbuttonvertbutton]
Size = 0, 1

[layout]
ContentMargins = 5, 2, 8, 6
SizingMargins = 5, 1, 6, 5
TextColor = 51 94 168
BackgroundImage = styles/ribbon/beige/ribbonpagedecor.png

[layoutbody]
BackgroundImage = styles/ribbon/beige/ribbonpage.png

[separatorhorz]
ContentMargins = 1, 0, 1, 2
SizingMargins = 1, 0, 1, 2
BackgroundImage = styles/ribbon/beige/ribbontopedge.png
