[togglebutton]
SizingMargins = 19, 2, 13, 2
ContentMargins = 12, 2, 2, 2
BackgroundImage = styles/overlap_tab/middle_selected_left.png
TextColor = 48 60 66

[togglebutton(hot)]
BackgroundImage = styles/overlap_tab/middle_hot_selected_left.png
TextColor = 48 60 66

[togglebutton(checked)]
BackgroundImage = styles/overlap_tab/middle_selected.png
TextColor = 48 60 66

[togglebutton(hotchecked)] = togglebutton(checked)

[togglebutton(pressed)]
BackgroundImage = styles/overlap_tab/middle_pressed_selected_left.png
TextColor = 48 60 66


[toolbutton] = togglebutton
