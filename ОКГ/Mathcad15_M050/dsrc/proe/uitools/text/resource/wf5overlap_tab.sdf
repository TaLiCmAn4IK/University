; 22-Mar-09 L-03-28+ IKAL  $$2  Updated.


[togglebutton]
SizingMargins = 4, 2, 4, 0
ContentMargins = 6, 4, 6, 4
BackgroundImage = styles/overlap_tab/button_normal.png
;ForegroundColor = 48 60 66
;Font = Arial, 12
;TextColor = 48 60 66

[togglebutton(hot)]
BackgroundImage = styles/overlap_tab/button_hot.png
;ForegroundColor = 48 60 66
;Font = Arial, 12
;TextColor = 48 60 66

[togglebutton(checked)]
BackgroundImage = styles/overlap_tab/button_active.png
;ForegroundColor = 48 60 66
;Font = Arial, 12
;TextColor = 48 60 66

[togglebutton(hotchecked)] = togglebutton(checked)

[togglebutton(pressed)]
BackgroundImage = styles/overlap_tab/button_pressed.png
;ForegroundColor = 48 60 66
;Font = Arial, 12
;TextColor = 48 60 66
