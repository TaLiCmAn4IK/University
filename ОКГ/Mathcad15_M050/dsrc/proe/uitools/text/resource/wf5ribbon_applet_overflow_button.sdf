[toolbutton]
ContentMargins = 5, 5, 5, 5
SizingMargins = 3, 3, 3, 3
Size = 15, 14
BackgroundImage = styles/ribbon/blank.png

[toolbutton(hot)]
BackgroundImage = styles/ribbon/wf5ribbon/ribbon_overflow_button_hover.png

[toolbutton(pressed)]
BackgroundImage = styles/ribbon/wf5ribbon/ribbon_overflow_button_pressed.png


[menu]
ContentMargins = 4, 4, 4, 4
SizingMargins = 1, 1, 1, 1
BackgroundImage = styles/ribbon/wf5ribbon/ribbon_overflow_menu_frame.png

[layoutbody]
SizingMargins  = 3, 3, 3, 3
BackgroundImage = styles/ribbon/wf5ribbon/ribbonappletoverflow.png
TransitionDuration = 500

