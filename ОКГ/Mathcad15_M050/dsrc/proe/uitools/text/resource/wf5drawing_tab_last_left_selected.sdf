[togglebutton]
SizingMargins = 19, 2, 30, 2
ContentMargins = 12, 2, 22, 2
BackgroundImage = styles/overlap_tab/last_selected_left.png
TextColor = 48 60 66

[togglebutton(hot)]
BackgroundImage = styles/overlap_tab/last_hot_selected_left.png
TextColor = 48 60 66

[togglebutton(checked)]
BackgroundImage = styles/overlap_tab/last_selected.png
TextColor = 48 60 66

[togglebutton(hotchecked)] = togglebutton(checked)

[togglebutton(pressed)]
BackgroundImage = styles/overlap_tab/last_pressed_selected_left.png
TextColor = 48 60 66


[toolbutton] = togglebutton
