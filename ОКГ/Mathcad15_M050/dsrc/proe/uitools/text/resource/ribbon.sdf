; Main Ribbon style definition
;
; 13-Dec-06 L-01-22 AW    $$1   Created
; 20-May-08 L-03-09 Asaf  $$2   Updated for beige
;

; All toggle button states use same SizingMargins
[togglebutton]
ContentMargins = 6, 3, 6, 2
SizingMargins = 6, 3, 6, 2
BackgroundImage = styles/ribbon/beige/ribbontabbutton.bif

[togglebutton(hot)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonhot.bif

[togglebutton(pressed)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonhot.bif

[togglebutton(checked)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonselected.bif

[togglebutton(hotchecked)]
BackgroundImage = styles/ribbon/beige/ribbontabbuttonselectedhot.bif

[layout]
ContentMargins = 5, 2, 8, 6
SizingMargins = 5, 1, 6, 5
TextColor = 51 94 168
BackgroundImage = styles/ribbon/beige/ribbonpagedecor.bif

[layoutbody]
BackgroundImage = styles/ribbon/beige/ribbonpage.bif

[separatorhorz]
ContentMargins = 1, 0, 1, 2
SizingMargins = 1, 0, 1, 2
BackgroundImage = styles/ribbon/beige/ribbontopedge.bif
