[splittoolbutton]
ContentMargins = 3, 3, 2, 2
SizingMargins = 3, 3, 3, 3
TransitionDuration = 250
BackgroundImage = styles/SAB/left_button_normal.bif

[splittoolbutton(hot)]
BackgroundImage = styles/SAB/right_button_hot.bif
TransitionDuration = 250

[splittoolbutton(focused)] = splittoolbutton(hot)

[splittoolbutton(hover)]
BackgroundImage = styles/SAB/SAB_splittoolbutton.bif
TransitionDuration = 250

[splittoolbutton(pressed)]
BackgroundImage = styles/SAB/right_button_pressed.bif
TransitionDuration = 250

[splittoolbuttonvertbutton]
BackgroundImage = styles/SAB/SAB_transparent.bif
Size = 0, 20
