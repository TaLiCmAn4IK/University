; 22-Mar-09 L-03-28+ IKAL  $$2  Updated.
; 01-Apr-09 L-03-30  IKAL  $$3  Fixed ContentMargins.
; 03-May-09 L-03-32  Moti  $$4  Added TextColor for checked state
; 18-May-09 L-03-33  IKAL  $$5  Fixed the TextColor.


; All toggle button states use same SizingMargins
[togglebutton]
ContentMargins = 5, 5, 5, 5
SizingMargins = 6, 4, 4, 1
SizingType = TileHorz
;BackgroundColor = UI_COLOR_TRANSPARENT
; We must use a whole transparent image otherwise it will use default image
BackgroundImage = styles/ribbon/wf5ribbon/ribbontabbutton.png

[togglebutton(hot)]
BackgroundImage = styles/ribbon/wf5ribbon/ribbontabbuttonhot.png

[togglebutton(pressed)]
BackgroundImage = styles/ribbon/wf5ribbon/ribbontabbuttonpressed.png

[togglebutton(checked)]
BackgroundImage = styles/ribbon/wf5ribbon/newribbontabbuttonselected.png
TextColor = 2 24 35

[togglebutton(hotchecked)] = togglebutton(checked)

[toolbutton] = togglebutton

[splitbutton] = togglebutton

[splitbuttonvertbutton]
Size = 0, 1

[layout]
ContentMargins = 2, 0, 2, 5
SizingMargins = 0, 0, 0, 4
BackgroundImage = styles/ribbon/wf5ribbon/ribbonpagedecor.png

[layoutbody]
ContentMargins = 1, 3, 1, 0
SizingMargins = 0, 0, 0, 0
BackgroundImage = styles/ribbon/wf5ribbon/ribbonpage.png

[separatorhorz]
ContentMargins = 1, 0, 1, 2
SizingMargins = 1, 0, 1, 2
BackgroundImage = styles/ribbon/ribbontopedge.bif
