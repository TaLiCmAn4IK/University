; ToggleButton

[togglebutton]
BackgroundImage = styles/col_sash/col_sash_left_arrow_wf5browser.png
Size = 9, 94
ContentMargins = 1, 1, 1, 1

[togglebutton(hot)]
BackgroundImage = styles/col_sash/col_sash_left_arrow_wf5browser_hot.png

[togglebutton(checked)]
BackgroundImage = styles/col_sash/col_sash_left_arrow_wf5browser_selected.png

[togglebutton(pressed)]
BackgroundImage = styles/col_sash/col_sash_left_arrow_wf5browser_pressed.png
